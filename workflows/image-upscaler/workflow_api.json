{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Input image"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "4x model upscale"
    }
  },
  "4": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "lanczos",
      "scale_by": 0.5
    },
    "_meta": {
      "title": "Final scale (0.5 => 2x overall, 1.0 => 4x)"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "filename_prefix": "comfy-api-apps/upscale"
    },
    "_meta": {
      "title": "Output"
    }
  }
}
