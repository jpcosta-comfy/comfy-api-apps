  "17": {
    "class_type": "GeminiImage2Node",
    "inputs": {
      "images": [
        "19",
        0
      ],
      "prompt": "Swap the product the subject is holding in image 1 with the product in image 2. Keep the same hand, grip, pose, camera angle, and lighting. Only replace the held object with product Y from image 2.",
