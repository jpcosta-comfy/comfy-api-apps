# Comfy platform API key. Server only — never expose this to the browser.
COMFY_CLOUD_API_KEY=

# Optional. Defaults to https://cloud.comfy.org
COMFY_CLOUD_BASE_URL=https://cloud.comfy.org

# Set to 1 to run the UI without calling Comfy Cloud. Sample outputs are
# generated on the server from the image you upload.
COMFY_MOCK=

# Optional HMAC key for output download URLs (?sig=). If unset, the server
# uses SHA-256 of COMFY_CLOUD_API_KEY.
OUTPUT_SIGNING_SECRET=
