# Server only — never expose these to the browser, and do not commit a real key.
# Set ONE of these on Vercel (Production and Preview). COMFY_API_KEY wins if both are set.
# COMFY_CLOUD_API_KEY is the name already used in this project; keep it if that is what Vercel has.
COMFY_API_KEY=
COMFY_CLOUD_API_KEY=

# Optional per-app deployment hosts. Leave unset to use workflows/deployments.json
# (the personal *.run.comfy.app endpoints). Set one on Vercel only to override that app.
# COMFY_CLOUD_BASE_URL is not read. Do not point these at https://cloud.comfy.org.
# COMFY_BASE_URL_SPRITE_GENERATOR=https://dep-6e5a0ab1-8131-4ee8-acb7-ae1840160e13.run.comfy.app
# COMFY_BASE_URL_BACKGROUND_REMOVAL=https://dep-e45cb437-0991-4689-9f7c-77d5748e3adc.run.comfy.app
# COMFY_BASE_URL_VIRTUAL_TRY_ON=https://dep-d99a045a-86e9-4251-bbae-0a88940f78d1.run.comfy.app

# Set to 1 to run the UI without calling a deployment. Sample outputs are
# generated on the server from the image you upload.
COMFY_MOCK=

# Optional HMAC key for output download URLs (?sig=). If unset, the server
# uses SHA-256 of the resolved API key (COMFY_API_KEY, else COMFY_CLOUD_API_KEY).
OUTPUT_SIGNING_SECRET=
